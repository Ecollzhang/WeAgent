# RAG 检索服务 (rag)
RAG_PORT=5104
RAG_DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/weagent_rag?charset=utf8mb4

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password

# JWT — 必须与核心服务 .env 中的 JWT_SECRET_KEY 一致
JWT_SECRET_KEY=copy-from-core-service-.env
SECRET_KEY=copy-from-core-service-.env

# 服务间认证 — sandbox 容器通过此 key 调用 RAG 检索接口
INTERNAL_API_KEY=your-internal-api-key

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# 向量数据库 (TODO: 后续接入)
VECTOR_STORE_TYPE=chromadb
CHROMA_HOST=localhost
CHROMA_PORT=8000
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# Embedding 模型 (TODO: 后续接入)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
