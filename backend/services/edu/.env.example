# 智慧教育领域服务 (edu)
EDU_PORT=5102
EDU_DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/weagent_edu?charset=utf8mb4

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password

# JWT — 必须与核心服务 .env 中的 JWT_SECRET_KEY 一致
JWT_SECRET_KEY=copy-from-core-service-.env
SECRET_KEY=copy-from-core-service-.env

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# 独立 RAG 服务：Education 文件先持久化，再以课程范围建立索引
EDUCATION_RAG_ENABLED=true
EDUCATION_RAG_INGESTION_ENABLED=true
RAG_SERVICE_URL=http://127.0.0.1:5104
RAG_INTERNAL_API_KEY=copy-from-rag-service-.env
