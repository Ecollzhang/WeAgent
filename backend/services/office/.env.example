# 智慧办公领域服务 (office)
OFFICE_PORT=5103
OFFICE_DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/weagent_office?charset=utf8mb4

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password

# JWT — 必须与核心服务 .env 中的 JWT_SECRET_KEY 一致
JWT_SECRET_KEY=copy-from-core-service-.env
SECRET_KEY=copy-from-core-service-.env

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
