# 在 backend 目录执行 Copy-Item .env.example .env，然后在本机 .env 中填写连接信息和签名密钥。
# 在线模型的密钥和接口配置见仓库根目录的 .env.example。
FLASK_ENV=development
PORT=5002

# MySQL 的账户需要能访问 weagent 数据库。填入本机账户和密码。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=weagent

# Redis 如果启用了密码认证，在 REDIS_PASSWORD 中填写密码。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 分别生成两个随机值，填写 JWT 签名密钥和 Flask 密钥。可运行以下命令两次。
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
SECRET_KEY=

# 沙箱通常使用本机 Docker Desktop。需要指定 Docker 端点时，可按实际地址启用下一行。
# DOCKER_HOST=npipe:////./pipe/docker_engine

# 域服务网关的请求超时（秒），包括创建 Docker 沙箱所需的时间。
DOMAIN_PROXY_TIMEOUT_SECONDS=180
