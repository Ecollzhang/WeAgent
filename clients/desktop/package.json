{
  "name": "weagent-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "make:icon": "node scripts/make-icon.cjs",
    "build": "vite build",
    "electron:build": "npm run make:icon && npm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "codemirror": "^5.65.16",
    "element-ui": "^2.15.14",
    "socket.io-client": "^4.7.2",
    "vue": "^2.7.15",
    "vue-codemirror": "^4.0.6",
    "vue-router": "^3.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.weagent.desktop",
    "productName": "WeAgent",
    "icon": "logo.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "logo.png",
      "logo.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "logo.ico",
      "signAndEditExecutable": false
    }
  }
}
